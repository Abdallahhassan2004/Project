<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Sense</title>
    <link rel="stylesheet" href="/CSS/checkout.css">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&family=Ubuntu+Condensed&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header>
        <div class="logo">
            <a href="/">Sense</a>
        </div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/living">Living</a></li>
                <li><a href="/bedroom">Bedroom</a></li>
                <li><a href="/dining">Dining</a></li>
                <li><a href="/kitchen">Kitchen</a></li>
            </ul>
        </nav>
        <div class="cart-icon">
            <a href="/cart">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count"><%= itemCount %></span>
            </a>
        </div>
    </header>

    <main>
        <div class="checkout-container">
            <div class="checkout-left">
                <h2>Shipping Information</h2>
                <form id="checkout-form" action="/checkout/process" method="POST">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" placeholder="01XXXXXXXXX" maxlength="11" required>
                        <small class="form-hint">Egyptian format: 11 digits starting with 01</small>
                    </div>
                    <div class="form-group">
                        <label for="address">Address</label>
                        <input type="text" id="address" name="address" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="city">City</label>
                            <input type="text" id="city" name="city" required>
                        </div>
                        <div class="form-group">
                            <label for="postalCode">Postal Code</label>
                            <input type="text" id="postalCode" name="postalCode" placeholder="12345" maxlength="5" required>
                            <small class="form-hint">5 digits</small>
                        </div>
                    </div>

                    <h2>Payment Information</h2>
                    <div class="form-group">
                        <label for="cardName">Name on Card</label>
                        <input type="text" id="cardName" name="cardName" required>
                    </div>
                    <div class="form-group">
                        <label for="cardNumber">Card Number</label>
                        <input type="text" id="cardNumber" name="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required>
                        <small class="form-hint">16 digits with spaces</small>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="expiryDate">Expiry Date</label>
                            <input type="text" id="expiryDate" name="expiryDate" placeholder="MM/YY" maxlength="5" required>
                            <small class="form-hint">MM/YY format</small>
                        </div>
                        <div class="form-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" name="cvv" placeholder="123" maxlength="3" required>
                            <small class="form-hint">3 digits</small>
                        </div>
                    </div>

                    <button type="submit" class="place-order-btn">Place Order</button>
                </form>
            </div>

            <div class="checkout-right">
                <div class="order-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-items">
                        <% cart.forEach(item => { %>
                            <div class="summary-item">
                                <div class="item-info">
                                    <span class="item-name"><%= item.name %></span>
                                    <span class="item-quantity">x<%= item.quantity %></span>
                                </div>
                                <span class="item-price">EGP <%= (parseFloat(item.price) * item.quantity).toFixed(2) %></span>
                            </div>
                        <% }); %>
                    </div>
                    <div class="summary-total">
                        <div class="total-row">
                            <span>Subtotal</span>
                            <span>EGP <%= total.toFixed(2) %></span>
                        </div>
                        <div class="total-row">
                            <span>Shipping</span>
                            <span>Free</span>
                        </div>
                        <div class="total-row grand-total">
                            <span>Total</span>
                            <span>EGP <%= total.toFixed(2) %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Update cart count when page loads
        async function updateCartCount() {
            try {
                const response = await fetch('/cart/count');
                if (response.ok) {
                    const data = await response.json();
                    document.querySelector('.cart-count').textContent = data.count;
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }

        // Call updateCartCount when page loads
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
            setupFormValidation();
        });

        // Setup form validation and formatting
        function setupFormValidation() {
            const phoneInput = document.getElementById('phone');
            const postalCodeInput = document.getElementById('postalCode');
            const cardNumberInput = document.getElementById('cardNumber');
            const expiryDateInput = document.getElementById('expiryDate');
            const cvvInput = document.getElementById('cvv');

            // Phone number validation - only numbers and Egyptian format
            phoneInput.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, ''); // Remove non-digits
                if (value.length > 0 && !value.startsWith('01')) {
                    value = '01' + value.substring(2);
                }
                e.target.value = value;
            });

            // Postal code validation - only numbers
            postalCodeInput.addEventListener('input', function(e) {
                e.target.value = e.target.value.replace(/\D/g, ''); // Remove non-digits
            });

            // Card number formatting - add spaces every 4 digits
            cardNumberInput.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, ''); // Remove non-digits
                value = value.replace(/(\d{4})(?=\d)/g, '$1 '); // Add space every 4 digits
                e.target.value = value;
            });

            // Expiry date formatting - add slash after MM
            expiryDateInput.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, ''); // Remove non-digits
                if (value.length >= 2) {
                    value = value.substring(0, 2) + '/' + value.substring(2);
                }
                e.target.value = value;
            });

            // CVV validation - only numbers, max 3 digits
            cvvInput.addEventListener('input', function(e) {
                e.target.value = e.target.value.replace(/\D/g, ''); // Remove non-digits
            });
        }

        // Form validation
        document.getElementById('checkout-form').addEventListener('submit', function(e) {
            e.preventDefault();
            console.log('Checkout form submission attempted.');
            
            // Get form values
            const fullName = document.getElementById('fullName').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const address = document.getElementById('address').value.trim();
            const city = document.getElementById('city').value.trim();
            const postalCode = document.getElementById('postalCode').value.trim();
            const cardName = document.getElementById('cardName').value.trim();
            const cardNumber = document.getElementById('cardNumber').value.trim();
            const expiryDate = document.getElementById('expiryDate').value.trim();
            const cvv = document.getElementById('cvv').value.trim();

            // Check for empty required fields
            if (!fullName || !email || !phone || !address || !city || !postalCode || !cardName || !cardNumber || !expiryDate || !cvv) {
                alert('Please fill in all required fields.');
                console.log('Validation failed: Missing required fields.');
                return;
            }

            // Email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                console.log('Validation failed: Invalid email.');
                return;
            }

            // Phone validation - Egyptian format (11 digits starting with 01)
            const phoneRegex = /^01\d{9}$/;
            if (!phoneRegex.test(phone)) {
                alert('Please enter a valid Egyptian phone number (11 digits starting with 01).');
                console.log('Validation failed: Invalid phone number.');
                return;
            }

            // Postal code validation (5 digits)
            const postalCodeRegex = /^\d{5}$/;
            if (!postalCodeRegex.test(postalCode)) {
                alert('Please enter a valid 5-digit postal code.');
                console.log('Validation failed: Invalid postal code.');
                return;
            }

            // Card number validation (16 digits without spaces)
            const cardNumberClean = cardNumber.replace(/\s/g, '');
            if (!/^\d{16}$/.test(cardNumberClean)) {
                alert('Please enter a valid 16-digit card number.');
                console.log('Validation failed: Invalid card number.');
                return;
            }

            // Expiry date validation (MM/YY format and not expired)
            const expiryRegex = /^(0[1-9]|1[0-2])\/\d{2}$/;
            if (!expiryRegex.test(expiryDate)) {
                alert('Please enter a valid expiry date (MM/YY).');
                console.log('Validation failed: Invalid expiry date format.');
                return;
            }

            // Check if card is expired
            const [month, year] = expiryDate.split('/');
            const currentDate = new Date();
            const currentYear = currentDate.getFullYear() % 100; // Get last 2 digits
            const currentMonth = currentDate.getMonth() + 1; // getMonth() returns 0-11

            if (parseInt(year) < currentYear || 
                (parseInt(year) === currentYear && parseInt(month) < currentMonth)) {
                alert('Card has expired. Please enter a valid expiry date.');
                console.log('Validation failed: Card expired.');
                return;
            }

            // CVV validation (3 digits)
            if (!/^\d{3}$/.test(cvv)) {
                alert('Please enter a valid 3-digit CVV.');
                console.log('Validation failed: Invalid CVV.');
                return;
            }

            // If all validation passes, submit the form
            console.log('Validation successful, submitting form...');
            this.submit();
        });
    </script>
</body>
</html> 