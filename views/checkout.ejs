<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Sense</title>
    <link rel="stylesheet" href="/CSS/checkout.css">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&family=Ubuntu+Condensed&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header>
        <div class="logo">
            <a href="/">Sense</a>
        </div>
        <nav>
            <ul>
                <li><a href="/home">Home</a></li>
                <li><a href="/living">Living</a></li>
                <li><a href="/bedroom">Bedroom</a></li>
                <li><a href="/dining">Dining</a></li>
                <li><a href="/kitchen">Kitchen</a></li>
            </ul>
        </nav>
        <div class="cart-icon">
            <a href="/cart">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count"><%= itemCount %></span>
            </a>
        </div>
    </header>

    <main>
        <div class="checkout-container">
            <div class="checkout-left">
                <h2>Shipping Information</h2>
                <form id="checkout-form" action="/checkout/process" method="POST">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" required>
                    </div>
                    <div class="form-group">
                        <label for="address">Address</label>
                        <input type="text" id="address" name="address" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="city">City</label>
                            <input type="text" id="city" name="city" required>
                        </div>
                        <div class="form-group">
                            <label for="postalCode">Postal Code</label>
                            <input type="text" id="postalCode" name="postalCode" required>
                        </div>
                    </div>

                    <h2>Payment Information</h2>
                    <div class="form-group">
                        <label for="cardName">Name on Card</label>
                        <input type="text" id="cardName" name="cardName" required>
                    </div>
                    <div class="form-group">
                        <label for="cardNumber">Card Number</label>
                        <input type="text" id="cardNumber" name="cardNumber" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="expiryDate">Expiry Date</label>
                            <input type="text" id="expiryDate" name="expiryDate" placeholder="MM/YY" required>
                        </div>
                        <div class="form-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" name="cvv" required>
                        </div>
                    </div>

                    <button type="submit" class="place-order-btn">Place Order</button>
                </form>
            </div>

            <div class="checkout-right">
                <div class="order-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-items">
                        <% cart.forEach(item => { %>
                            <div class="summary-item">
                                <div class="item-info">
                                    <span class="item-name"><%= item.name %></span>
                                    <span class="item-quantity">x<%= item.quantity %></span>
                                </div>
                                <span class="item-price">EGP <%= (parseFloat(item.price) * item.quantity).toFixed(2) %></span>
                            </div>
                        <% }); %>
                    </div>
                    <div class="summary-total">
                        <div class="total-row">
                            <span>Subtotal</span>
                            <span>EGP <%= total.toFixed(2) %></span>
                        </div>
                        <div class="total-row">
                            <span>Shipping</span>
                            <span>Free</span>
                        </div>
                        <div class="total-row grand-total">
                            <span>Total</span>
                            <span>EGP <%= total.toFixed(2) %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Update cart count when page loads
        async function updateCartCount() {
            try {
                const response = await fetch('/cart/count');
                if (response.ok) {
                    const data = await response.json();
                    document.querySelector('.cart-count').textContent = data.count;
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }

        // Call updateCartCount when page loads
        document.addEventListener('DOMContentLoaded', updateCartCount);

        // Form validation
        document.getElementById('checkout-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Basic validation
            const cardNumber = document.getElementById('cardNumber').value;
            const expiryDate = document.getElementById('expiryDate').value;
            const cvv = document.getElementById('cvv').value;

            // Simple card number validation (16 digits)
            if (!/^\d{16}$/.test(cardNumber.replace(/\s/g, ''))) {
                alert('Please enter a valid 16-digit card number');
                return;
            }

            // Expiry date validation (MM/YY format)
            if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiryDate)) {
                alert('Please enter a valid expiry date (MM/YY)');
                return;
            }

            // CVV validation (3 or 4 digits)
            if (!/^\d{3,4}$/.test(cvv)) {
                alert('Please enter a valid CVV (3 or 4 digits)');
                return;
            }

            // If all validation passes, submit the form
            this.submit();
        });
    </script>
</body>
</html> 