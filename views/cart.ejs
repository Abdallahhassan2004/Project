<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/cart.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header id="main-header">
        <div class="header-container">
            <h1 class="logo"><a href="/">Sense</a></h1>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/living">Living</a>
                <a href="/bedroom">Bedroom</a>
                <a href="/dining">Dining</a>
                <a href="/kitchen">Kitchen</a>
            </div>
            <a href="/cart" class="cart">cart <span class="cart-count">0</span></a>
        </div>
    </header>

    <main class="cart-container">
        <div class="section-title">
            <h2>Shopping Cart</h2>
        </div>
        
        <% if (cart && cart.length > 0) { %>
            <div class="cart-content">
                <div class="cart-left">
                    <% cart.forEach(item => { %>
                        <div class="cart-item" data-id="<%= item.id %>">
                            <img src="/Images/<%= item.image %>" alt="<%= item.name %>">
                            <div class="item-details">
                                <h3><%= item.name %></h3>
                                <p class="price">EGP <%= parseFloat(item.price).toFixed(2) %></p>
                                <div class="quantity-controls">
                                    <button class="quantity-btn" onclick="updateQuantity('<%= item.id %>', -1)">-</button>
                                    <span class="quantity-display"><%= item.quantity %></span>
                                    <button class="quantity-btn" onclick="updateQuantity('<%= item.id %>', 1)">+</button>
                                </div>
                            </div>
                            <button class="trash-icon" onclick="removeItem('<%= item.id %>')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    <% }); %>
                    <a href="/dining" class="continue-shopping">← Continue Shopping</a>
                </div>

                <div class="cart-right">
                    <div class="cart-summary">
                        <h3>Order Summary</h3>
                        <div class="summary-item">
                            <span>Items (<%= cart.reduce((sum, item) => sum + item.quantity, 0) %>)</span>
                            <span>EGP <%= cart.reduce((sum, item) => sum + (parseFloat(item.price) * item.quantity), 0).toFixed(2) %></span>
                        </div>
                        <div class="summary-item">
                            <span>Shipping</span>
                            <span>Free</span>
                        </div>
                        <div class="summary-item total">
                            <span>Total</span>
                            <span>EGP <%= cart.reduce((sum, item) => sum + (parseFloat(item.price) * item.quantity), 0).toFixed(2) %></span>
                        </div>
                        <a href="/checkout" class="checkout-btn" style="text-decoration: none;">Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="empty-cart">
                <i class="fas fa-shopping-cart"></i>
                <h2>Your cart is empty</h2>
                <p>Looks like you haven't added any items to your cart yet.</p>
                <a href="/dining" class="continue-shopping">Continue Shopping</a>
            </div>
        <% } %>
    </main>

    <script>
        // Update quantity
        async function updateQuantity(productId, change) {
            try {
                const response = await fetch(`/cart/update/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ change })
                });

                if (!response.ok) {
                    throw new Error('Failed to update quantity');
                }

                const data = await response.json();
                
                // Update cart count
                document.querySelector('.cart-count').textContent = data.cartCount;
                
                // Update totals
                if (data.total !== undefined) {
                    const totalElements = document.querySelectorAll('.summary-item span:last-child');
                    totalElements.forEach(el => {
                        if (el.parentElement.classList.contains('total')) {
                            el.textContent = 'EGP ' + parseFloat(data.total).toFixed(2);
                        } else if (!el.textContent.includes('Free')) {
                            el.textContent = 'EGP ' + parseFloat(data.total).toFixed(2);
                        }
                    });
                }
                
                // Reload page to show updated cart
                window.location.reload();
            } catch (error) {
                console.error('Error updating quantity:', error);
                alert('Failed to update quantity. Please try again.');
            }
        }

        // Remove item
        async function removeItem(productId) {
            if (!confirm('Are you sure you want to remove this item?')) return;

            try {
                const response = await fetch(`/cart/remove/${productId}`, {
                    method: 'POST'
                });

                if (!response.ok) {
                    throw new Error('Failed to remove item');
                }

                const data = await response.json();
                
                // Update cart count
                document.querySelector('.cart-count').textContent = data.cartCount;
                
                // Update totals
                if (data.total !== undefined) {
                    const totalElements = document.querySelectorAll('.summary-item span:last-child');
                    totalElements.forEach(el => {
                        if (el.parentElement.classList.contains('total')) {
                            el.textContent = 'EGP ' + parseFloat(data.total).toFixed(2);
                        } else if (!el.textContent.includes('Free')) {
                            el.textContent = 'EGP ' + parseFloat(data.total).toFixed(2);
                        }
                    });
                }
                
                // Reload page to show updated cart
                window.location.reload();
            } catch (error) {
                console.error('Error removing item:', error);
                alert('Failed to remove item. Please try again.');
            }
        }

        // Update cart count when page loads
        async function updateCartCount() {
            try {
                const response = await fetch('/cart/count');
                if (response.ok) {
                    const data = await response.json();
                    document.querySelector('.cart-count').textContent = data.count;
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }

        // Initialize cart functionality
        document.addEventListener('DOMContentLoaded', () => {
            updateCartCount();
        });
    </script>
</body>
</html>