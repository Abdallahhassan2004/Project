<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Heaven And Home | Stylish & Unique Homeware</title>
    <link rel="icon" type="image/png" href="<%= '/Images/logo.jpg' %>" />
    <link rel="stylesheet" href="<%= '/CSS/home.css' %>" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div id="intro-screen">
        <div class="intro-title">Sense</div>
        <% const introImages = ['intr.jpg', 'intro2.jpg', 'intro6.jpg', 'intro3.jpg', 'intro5.jpg', 'intro1.jpg']; %>
        <% introImages.forEach((img, index) => { %>
            <div class="intro-img img<%= index + 1 %>">
                <img src="<%= '/Images/Home/' + img %>" alt="Intro <%= index + 1 %>" />
            </div>
        <% }); %>
    </div>

    <!-- Hero Section with video background -->
    <div class="hero">
        <video autoplay muted loop playsinline>
            <source src="<%= '/videos/welcome.mp4' %>" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
        <h1>Welcome to Our Site</h1>
    </div>

    <!-- Header -->
    <header id="main-header">
        <div class="header-container">
            <div class="menu-toggle animate-icon" onclick="toggleMenu()">☰</div>
            <h1 class="logo"><a href="/">Sense</a></h1>

            <a href="/cart" class="cart">cart <span class="cart-count">0</span></a>
        </div>

        <div class="full-menu" id="fullMenu">
            <div class="menu-left">
                <!-- 🔍 Search Bar -->
                <div class="menu-search">
                    <input type="text" id="search-input" placeholder="Search for products..." />
                    <button onclick="handleSearchClick()">Search</button>
                </div>

                <!-- Menu Columns -->
                <div class="menu-columns">
                    <div class="column">
                        <h2>Sense</h2>
                        <ul>
                            <li><a href="/#about-section">About</a></li>
                            <li><a href="/#contact-section">Contact</a></li>
                            <li><a href="/login">Log In</a></li>
                            <li><a href="/signup">Sign Up</a></li>
                        </ul>
                    </div>
                    <div class="column">
                        <h2>SHOP</h2>
                        <ul>
                            <li><a href="/Home"></a></li>
                            <li><a href="/living">Living Room</a></li>
                            <li><a href="/bedroom">Bedroom</a></li>
                            <li><a href="/kitchen">Kitchen</a></li>
                            <li><a href="/dining">Dining Room</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Image Section -->
            <div class="menu-right">
                <img src="<%= '/Images/Home/intro5.jpg' %>" alt="Hm1" />
            </div>
        </div>
    </header>

    <!-- Image & Style Intro Section -->
    <section class="style-intro-section">
        <div class="floating-images">
            <% const decorImages = ['img3.jpg', 'img2.jpg', 'img4.jpg', 'img1.jpg']; %>
            <% decorImages.forEach((img, index) => { %>
                <img src="<%= '/Images/Home/' + img %>" alt="Decor <%= index + 1 %>" class="float <%= index % 2 === 0 ? 'top-left' : 'top-right' %>" />
            <% }); %>
        </div>
        <div class="style-text">
            <h1>CREATING PERFECT<br>LINES AND IMPOSING<br>PRESENCE</h1>
            <p>
                Developed the concept of exclusivity, our range features timeless furniture with
                natural fabrics, curved lines, and classic design. Enchanting in their sobriety—
                faithful to the past, modern for the present.
            </p>
            <a href="#about-section" class="read-btn">READ ABOUT US</a>
        </div>
    </section>

    <!-- Shop by Room -->
    <section class="shop-by-room-section">
        <div class="section-title">
            <h2 class="shop-by-room-title">Shop By Room</h2>
        </div>
        <div class="clickable-image-grid">
            <% const rooms = [
                { name: 'Living Room', img: 'intr.jpg', link: 'living.html' },
                { name: 'Bedroom', img: 'bedroom1.jpg', link: 'bedroom.html' },
                { name: 'Dining', img: 'JapandiDining4.jpg', link: 'dining.html' },
                { name: 'Kitchen', img: 'kitchen2.jpg', link: 'kitchen.html' }
            ]; %>
            <% rooms.forEach(room => { %>
                <div class="image-container" data-name="<%= room.name %>">
                    <a href="<%= room.link %>">
                        <img src="<%= '/Images/Home/' + room.img %>" alt="<%= room.name %>" />
                    </a>
                    <p><%= room.name %></p>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- About Section -->
    <section id="about-section" class="about-section">
        <div class="about-content">
            <h2 class="section-title">OUR FURNITURE <br>STORY</h2>
            <% const aboutInfo = [
                { number: '01.', title: 'OBJECTS', text: 'Specialized in adornments, it will bring charm to any environment. There are thousands of high quality pieces, with styles that transition from classic to contemporary.' },
                { number: '02.', title: 'CONTEMPORARY', text: 'The pieces stand out for their contemporary straight lines and imposing presence. Following global trends, the furniture stands out for its noble and innovative materials.' },
                { number: '03.', title: 'BEDROOM', text: 'With high customization, the furniture meets any expectations—composing cozy, charming rooms for the most intimate spaces of the house.' },
                { number: '04.', title: 'INDUSTRY', text: 'Furniture that integrates sustainability, quality, and design. The corporate line offers better cost, well-being, and renowned brands.' }
            ]; %>
            <% aboutInfo.forEach(info => { %>
                <div class="info-row">
                    <div class="number"><%= info.number %></div>
                    <div class="info-text">
                        <h3><%= info.title %></h3>
                        <p><%= info.text %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter-section">
        <div class="newsletter-content">
            <h2>Be a part of our club</h2>
            <form class="newsletter-form">
                <input type="email" placeholder="Enter your email" required />
                <button type="submit">Join</button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-wrapper">
            <div class="footer-grid">
                <% const footerSections = [
                    { title: 'Store', links: ['Home', 'About', 'Journal', 'Contact'] },
                    { title: 'Shop', links: ['All', 'Lookbook', 'Collections', 'Featured'] },
                    { title: 'Collections', links: ['Decors', 'Furnitures', 'Ceramic', 'Lamps'] },
                    { title: 'Help', links: ['Contact', 'Login & Account', 'Privacy Policy', 'Refund policy'] }
                ]; %>
                <% footerSections.forEach(section => { %>
                    <div class="footer-box">
                        <h4><%= section.title %></h4>
                        <ul>
                            <% section.links.forEach(link => { %>
                                <li><a href="#"><%= link %></a></li>
                            <% }); %>
                        </ul>
                    </div>
                <% }); %>
            </div>
        </div>
        <div class="footer-brand">
            <h2>Sense</h2>
        </div>
    </footer>

    <script>
        document.getElementById('search-input').addEventListener('keydown', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                handleSearchClick();
            }
        });

        function handleSearchClick() {
            const query = document.getElementById('search-input').value.trim().toLowerCase();
            const roomPages = {
                "living": "living.html",
                "living room": "living.html",
                "bed": "bedroom.html",
                "bedroom": "bedroom.html",
                "kitchen": "kitchen.html",
                "dining": "dining.html",
                "dining room": "dining.html"
            };

            const matchedKey = Object.keys(roomPages).find(key => query.includes(key));

            if (matchedKey) {
                window.location.href = roomPages[matchedKey];
            } else {
                alert("No matching room found. Try: living, bed, kitchen, dining.");
            }
        }

        function toggleMenu() {
            const menu = document.getElementById("fullMenu");
            const toggleBtn = document.querySelector(".menu-toggle");

            menu.classList.toggle("active");
            toggleBtn.textContent = menu.classList.contains("active") ? "✕" : "☰";
        }

        window.addEventListener("scroll", function () {
            const header = document.getElementById("main-header");
            const hero = document.querySelector(".hero");
            if (!hero) return;

            const heroHeight = hero.offsetHeight;
            header.classList.toggle("scrolled", window.scrollY >= heroHeight - 80);
        });

        function updateCartCount(count) {
            document.querySelector('.cart-count').textContent = count;
        }

        updateCartCount(3);
    </script>
</body>
</html>