                description: 'Transform your kitchen with this modern design. Features sleek cabinets, modern appliances, and a spacious layout perfect for any home.',
                thumbnails: [
                    'kitchen 1/d1.jpg',
                    'kitchen 1/kit1 2.jpg',
                    'kitchen 1/kit1 3.jpg',
                    'kitchen 1/kit1 4.jpg',
                    'kitchen 1/kit1 5.jpg'
                ]
            },
            {
                id: 2,
                image: 'kitchen 2/kit2 2.jpg',
                price: '£1,599',
                title: 'Contemporary Kitchen',
                alt: 'Contemporary Kitchen',
                description: 'Upgrade your kitchen with this contemporary design. Featuring clean lines, modern finishes, and efficient storage solutions.',
                thumbnails: [
                    'kitchen 2/kit2 1.jpg',
