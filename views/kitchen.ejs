<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/category.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header id="main-header">
        <div class="header-container">
            <div class="menu-toggle animate-icon" onclick="toggleMenu()">☰</div>
            <h1 class="logo"><a href="/">Sense</a></h1>
            <a href="/cart" class="cart">bag <span></span>
                <span class="cart-count">0</span>
            </a>
        </div>

        <div class="full-menu" id="fullMenu">
            <div class="menu-left">
                <!-- 🔍 Search Bar -->
                <div class="menu-search">
                    <input type="text" id="search-input" placeholder="Search for products..." />
                    <button onclick="handleSearchClick()">Search</button>
                </div>

                <!-- Menu Columns -->
                <div class="menu-columns">
                    <div class="column">
                        <h2>Sense</h2>
                        <ul>
                            <li><a href="/#about-section">About</a></li>
                            <li><a href="/#contact-section">Contact</a></li>
                            <li><a href="/login">Log In</a></li>
                            <li><a href="/signup">Sign Up</a></li>
                        </ul>
                    </div>
                    <div class="column">
                        <h2>SHOP</h2>
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/living">Living Room</a></li>
                            <li><a href="/bedroom">Bedroom</a></li>
                            <li><a href="/kitchen">Kitchen</a></li>
                            <li><a href="/dining">Dining Room</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Image Section -->
            <div class="menu-right">
                <img src="/Images/Home/intro5.jpg" alt="Hm1" />
            </div>
        </div>
    </header>

    <!-- Breadcrumb Section -->
    <section class="breadcrumb-section">
        <h1 class="h2style woocommerce-products-header__title uppercase heading-font">Kitchen Furniture</h1>
        <div class="content_section">
            <p class="p2 paragraph-font text-center">
                <span class="s1 span-font">HOME / FURNITURE / KITCHEN</span>
            </p>
        </div>
    </section>

    <!-- Product List Section -->
    <div class="product-list">
        <% kitchens.forEach(kitchen => { %>
            <div class="product">
                <a href="<%= kitchen.link %>">
                    <img src="<%= kitchen.image %>" alt="<%= kitchen.alt %>">
                </a>
                <div class="price"><%= kitchen.price %></div>
                <a href="<%= kitchen.link %>" class="product-title"><%= kitchen.title %></a>
            </div>
        <% }) %>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-wrapper">
            <!-- Grid Columns with Bordered Boxes -->
            <div class="footer-grid">
                <div class="footer-box">
                    <h4>Store</h4>
                    <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">About</a></li>
                        <li><a href="#">Journal</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-box">
                    <h4>Shop</h4>
                    <ul>
                        <li><a href="#">All</a></li>
                        <li><a href="#">Lookbook</a></li>
                        <li><a href="#">Collections</a></li>
                        <li><a href="#">Featured</a></li>
                    </ul>
                </div>
                <div class="footer-box">
                    <h4>Collections</h4>
                    <ul>
                        <li><a href="#">Decors</a></li>
                        <li><a href="#">Furnitures</a></li>
                        <li><a href="#">Ceramic</a></li>
                        <li><a href="#">Lamps</a></li>
                    </ul>
                </div>
                <div class="footer-box">
                    <h4>Help</h4>
                    <ul>
                        <li><a href="#">Contact</a></li>
                        <li><a href="#">Login & Account</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Refund policy</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Store name in its own full-width block at the bottom -->
        <div class="footer-brand">
            <h2>Sense</h2>
        </div>
    </footer>

    <script src="/JavaScript/kitchen.js"></script>
</body>
</html>