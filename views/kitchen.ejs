<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="<%= '/CSS/category.css' %>">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&family=Ubuntu+Condensed&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        .product-details {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            overflow-y: auto;
        }

        .details-content {
            background: white;
            margin: 1rem auto;
            padding: 1.5rem;
            max-width: 1400px;
            width: 95%;
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            align-items: start;
        }

        .close-details {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            font-size: 1.5rem;
            cursor: pointer;
            color: #333;
            z-index: 1;
        }

        .image-gallery {
            display: grid;
            grid-template-columns: 80px 1fr;
            gap: 0.5rem;
        }

        .thumbnail-images {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            cursor: pointer;
            border-radius: 4px;
        }

        .main-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 8px;
        }

        .product-info {
            padding: 0.5rem;
        }

        .product-title {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            font-family: 'Bebas Neue', sans-serif;
        }

        .product-price {
            font-size: 1.25rem;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .product-description {
            color: #777;
            line-height: 1.4;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .add-to-cart-btn {
            background: #333;
            color: white;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.3s;
            width: 100%;
            max-width: 300px;
        }

        .add-to-cart-btn:hover {
            background: #444;
        }

        .related-products {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #eee;
            grid-column: 1 / -1;
        }

        .related-products h3 {
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
            font-family: 'Bebas Neue', sans-serif;
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.75rem;
        }

        .related-item {
            text-align: center;
        }

        .related-item img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 0.25rem;
        }

        .related-item p {
            font-size: 0.9rem;
            color: #333;
        }

        @media (max-width: 768px) {
            .details-content {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .image-gallery {
                grid-template-columns: 60px 1fr;
            }

            .thumbnail {
                width: 60px;
                height: 60px;
            }

            .main-image {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header id="main-header">
        <div class="header-container">
            <div class="menu-toggle animate-icon" onclick="toggleMenu()">☰</div>
            <h1 class="logo"><a href="/">Sense</a></h1>
            <a href="/cart" class="cart">bag <span></span>
                <span class="cart-count">0</span>
            </a>
        </div>

        <div class="full-menu" id="fullMenu">
            <div class="menu-left">
                <!-- 🔍 Search Bar -->
                <div class="menu-search">
                    <input type="text" id="search-input" placeholder="Search for products..." />
                    <button onclick="handleSearchClick()">Search</button>
                </div>

                <!-- Menu Columns -->
                <div class="menu-columns">
                    <div class="column">
                        <h2>Sense</h2>
                        <ul>
                            <li><a href="/#about-section">About</a></li>
                            <li><a href="/#contact-section">Contact</a></li>
                            <li><a href="/login">Log In</a></li>
                            <li><a href="/signup">Sign Up</a></li>
                        </ul>
                    </div>
                    <div class="column">
                        <h2>SHOP</h2>
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/living">Living Room</a></li>
                            <li><a href="/bedroom">Bedroom</a></li>
                            <li><a href="/kitchen">Kitchen</a></li>
                            <li><a href="/dining">Dining Room</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Image Section -->
            <div class="menu-right">
                <img src="<%= '/Images/Home/intro5.jpg' %>" alt="Hm1" />
            </div>
        </div>
    </header>

    <!-- Breadcrumb Section -->
    <section class="breadcrumb-section">
        <h1 class="h2style woocommerce-products-header__title uppercase heading-font">Kitchen Furniture</h1>
        <div class="content_section">
            <p class="p2 paragraph-font text-center">
                <span class="s1 span-font">HOME / FURNITURE / KITCHEN</span>
            </p>
        </div>
    </section>

    <!-- Product List Section -->
    <div class="product-list">
        <% const kitchenProducts = [
            {
