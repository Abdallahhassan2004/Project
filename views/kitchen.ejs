                    'kitchen 6/kit6 3.jpg',
                    'kitchen 6/kit6 4.jpg',
                    'kitchen 6/kit6 5.jpg'
                ]
            }
        ]; %>

        <% kitchenProducts.forEach(product => { %>
            <div class="product">
                <a href="#" onclick="showProductDetails('<%= product.id %>'); return false;">
                    <img src="/Images/kitchen/<%= product.image %>" alt="<%= product.alt %>">
                </a>
                <div class="price"><%= product.price %></div>
                <a href="#" onclick="showProductDetails('<%= product.id %>'); return false;" class="product-title"><%= product.title %></a>
            </div>
        <% }); %>
    </div>

    <!-- Product Details Modal -->
    <div id="productDetails" class="product-details">
        <div class="details-content">
            <span class="close-details" onclick="closeDetails()">&times;</span>
            <div class="image-gallery">
                <div class="thumbnail-images" id="thumbnails"></div>
                <img id="mainImage" class="main-image" src="" alt="">
            </div>
            <div class="product-info">
                <h2 id="productTitle" class="product-title"></h2>
                <p id="productPrice" class="product-price"></p>
                <p id="productDescription" class="product-description"></p>
                <button class="add-to-cart-btn" onclick="addToCart()">Add to Cart</button>
            </div>
            <div class="related-products">
                <h3>You May Also Like</h3>
                <div class="related-grid">
                    <div class="related-item">
                        <a href="/living">
                            <img src="/Images/livingRooms/L1/L1.avif" alt="Contemporary Living Room">
                            <p>Contemporary Living Room</p>
                        </a>
                    </div>
                    <div class="related-item">
                        <a href="/dining">
                            <img src="/Images/dining/d1/1d.webp" alt="Contemporary Dining">
                            <p>Contemporary Dining</p>
                        </a>
                    </div>
                    <div class="related-item">
                        <a href="/bedroom">
                            <img src="/Images/bedrooms/b1/5.jpg" alt="Contemporary Bedroom">
                            <p>Contemporary Bedroom</p>
                        </a>
                    </div>
                    <div class="related-item">
                        <a href="/kitchen">
                            <img src="/Images/kitchen/kitchen 2/kit2 2.jpg" alt="Contemporary Kitchen">
                            <p>Contemporary Kitchen</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-wrapper">
            <div class="footer-grid">
                <% const footerSections = [
                    { title: 'Store', links: ['Home', 'About', 'Journal', 'Contact'] },
                    { title: 'Shop', links: ['All', 'Lookbook', 'Collections', 'Featured'] },
                    { title: 'Collections', links: ['Decors', 'Furnitures', 'Ceramic', 'Lamps'] },
                    { title: 'Help', links: ['Contact', 'Login & Account', 'Privacy Policy', 'Refund policy'] }
                ]; %>
                
                <% footerSections.forEach(section => { %>
                    <div class="footer-box">
                        <h4><%= section.title %></h4>
                        <ul>
                            <% section.links.forEach(link => { %>
                                <li><a href="#"><%= link %></a></li>
                            <% }); %>
                        </ul>
                    </div>
                <% }); %>
            </div>
        </div>
        <div class="footer-brand">
            <h2>Sense</h2>
        </div>
    </footer>

    <script>
        function handleSearchClick() {
            const query = document.getElementById('search-input').value.trim().toLowerCase();
            const roomPages = {
                "living": "/living",
                "living room": "/living",
                "bed": "/bedroom",
                "bedroom": "/bedroom",
                "kitchen": "/kitchen",
                "dining": "/dining",
                "dining room": "/dining"
            };

            const matchedKey = Object.keys(roomPages).find(key => query.includes(key));

            if (matchedKey) {
                window.location.href = roomPages[matchedKey];
            } else {
                alert("No matching room found. Try: living, bed, kitchen, dining.");
            }
        }

        function toggleMenu() {
            const menu = document.getElementById("fullMenu");
            const toggleBtn = document.querySelector(".menu-toggle");
            menu.classList.toggle("active");
            toggleBtn.textContent = menu.classList.contains("active") ? "✕" : "☰";
        }

        // Add event listener for search input
        document.getElementById('search-input').addEventListener('keydown', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                handleSearchClick();
            }
        });

        // Update cart count (this should be replaced with actual cart count from server)
        function updateCartCount(count) {
            document.querySelector('.cart-count').textContent = count;
        }

        // Initialize cart count (this should be replaced with actual cart count from server)
        updateCartCount(0);

        const kitchenProducts = [
            {
                id: 1,
                image: 'kitchen 1/kit1 5.jpg',
                price: '£1,499',
                title: 'Modern Kitchen',
                alt: 'Modern Kitchen',
                description: 'Transform your kitchen with this modern design. Features sleek cabinets, modern appliances, and a spacious layout perfect for any home.',
                thumbnails: [
                    'kitchen 1/kit1 1.jpg',
                    'kitchen 1/kit1 2.jpg',
                    'kitchen 1/kit1 3.jpg',
                    'kitchen 1/kit1 4.jpg',
                    'kitchen 1/kit1 5.jpg'
                ]
            },
            {
                id: 2,
                image: 'kitchen 2/kit2 2.jpg',
                price: '£1,599',
                title: 'Contemporary Kitchen',
                alt: 'Contemporary Kitchen',
                description: 'Upgrade your kitchen with this contemporary design. Featuring clean lines, modern finishes, and efficient storage solutions.',
                thumbnails: [
                    'kitchen 2/kit2 1.jpg',
                    'kitchen 2/kit2 2.jpg',
                    'kitchen 2/kit2 3.jpg',
                    'kitchen 2/kit2 4.jpg',
                    'kitchen 2/kit2 5.jpg'
                ]
            },
            {
                id: 3,
                image: 'kitchen 3/kit3 2.jpg',
                price: '£1,800',
                title: 'Classic Kitchen',
                alt: 'Classic Kitchen',
                description: 'Add timeless elegance to your home with this classic kitchen design. Traditional styling with modern functionality.',
                thumbnails: [
                    'kitchen 3/kit3 1.jpg',
                    'kitchen 3/kit3 2.jpg',
                    'kitchen 3/kit3 3.jpg',
                    'kitchen 3/kit3 4.jpg',
                    'kitchen 3/kit3 5.jpg'
                ]
            },
            {
                id: 4,
                image: 'kitchen 4/kit4 2.jpg',
                price: '£1,650',
                title: 'Rustic Kitchen',
                alt: 'Rustic Kitchen',
                description: 'Bring natural warmth to your kitchen with this rustic design. Made from quality materials with a natural finish.',
                thumbnails: [
                    'kitchen 4/kit4 1.jpg',
                    'kitchen 4/kit4 2.jpg',
                    'kitchen 4/kit4 3.jpg',
                    'kitchen 4/kit4 4.jpg',
                    'kitchen 4/kit4 5.jpg'
                ]
            },
            {
                id: 5,
                image: 'kitchen 5/kit5 2.jpg',
                price: '£1,750',
                title: 'Minimalist Kitchen',
                alt: 'Minimalist Kitchen',
                description: 'Clean and efficient minimalist kitchen design. Perfect for modern living with smart storage solutions.',
                thumbnails: [
                    'kitchen 5/kit5 1.jpg',
                    'kitchen 5/kit5 2.jpg',
                    'kitchen 5/kit5 3.jpg',
                    'kitchen 5/kit5 4.jpg',
                    'kitchen 5/kit5 5.jpg'
                ]
            },
            {
                id: 6,
                image: 'kitchen 6/kit6 2.jpg',
                price: '£1,900',
                title: 'Luxury Kitchen',
                alt: 'Luxury Kitchen',
                description: 'High-end luxury kitchen design with premium materials and state-of-the-art appliances.',
                thumbnails: [
                    'kitchen 6/kit6 1.jpg',
                    'kitchen 6/kit6 2.jpg',
                    'kitchen 6/kit6 3.jpg',
                    'kitchen 6/kit6 4.jpg',
                    'kitchen 6/kit6 5.jpg'
                ]
            }
        ];

        function showProductDetails(productId) {
            const product = kitchenProducts.find(p => p.id === parseInt(productId));
            if (!product) return;

            const modal = document.getElementById('productDetails');
            const mainImage = document.getElementById('mainImage');
            const thumbnailsContainer = document.getElementById('thumbnails');
            
            // Update main image
            mainImage.src = '/Images/kitchen/' + product.image;
            
            // Clear and update thumbnails
            thumbnailsContainer.innerHTML = '';
            product.thumbnails.forEach(thumb => {
                const img = document.createElement('img');
                img.src = '/Images/kitchen/' + thumb;
                img.alt = product.title;
                img.className = 'thumbnail';
                img.onclick = () => mainImage.src = '/Images/kitchen/' + thumb;
                thumbnailsContainer.appendChild(img);
            });
            
            // Update product info
            document.getElementById('productTitle').textContent = product.title;
            document.getElementById('productPrice').textContent = product.price;
            document.getElementById('productDescription').textContent = product.description;
            
            modal.style.display = 'block';
        }

        function closeDetails() {
            document.getElementById('productDetails').style.display = 'none';
        }

        function addToCart() {
            // Add to cart functionality
            alert('Product added to cart!');
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('productDetails');
            if (event.target == modal) {
                modal.style.display = 'none';
            }
        }
    </script>
</body>
</html>