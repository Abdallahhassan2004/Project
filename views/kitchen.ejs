                    'kitchen 3/kit3 3.jpg',
                    'kitchen 3/kit3 4.jpg',
                    'kitchen 3/kit3 5.jpg'
                ]
            },
            {
                id: 4,
                image: 'kitchen 4/kit4 2.jpg',
                price: '£1,650',
                title: 'Rustic Kitchen',
                alt: 'Rustic Kitchen',
                description: 'Bring natural warmth to your kitchen with this rustic design. Made from quality materials with a natural finish.',
                thumbnails: [
                    'kitchen 4/kit4 1.jpg',
                    'kitchen 4/kit4 2.jpg',
                    'kitchen 4/kit4 3.jpg',
                    'kitchen 4/kit4 4.jpg',
                    'kitchen 4/kit4 5.jpg'
                ]
            },
            {
                id: 5,
