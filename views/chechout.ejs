<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Checkout | Sense</title>
    <link rel="icon" type="image/png" href="../Images/logo.jpg" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../CSS/checkout.css">
</head>
<body>

    <header id="main-header">
        <div class="header-container">
            <h1 class="logo"><a href="/home">Sense</a></h1>
        </div>
    </header>

    <div class="checkout-container">
        <h2>Checkout</h2>
        
        <!-- Order Summary Section -->
        <div class="order-summary">
            <h3>Order Summary</h3>
            <div id="checkout-items">
                <% if (cart && cart.length > 0) { %>
                    <% cart.forEach(item => { %>
                        <div class="checkout-item">
                            <span><%= item.name %> x <%= item.quantity %></span>
                            <span>£<%= (item.price * item.quantity).toFixed(2) %></span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <script>window.location.href = '/cart';</script>
                <% } %>
            </div>
            <div class="summary-total">
                <span>Total:</span>
                <span id="checkout-total">£<%= cart.reduce((sum, item) => sum + (item.price * item.quantity), 0).toFixed(2) %></span>
            </div>
        </div>

        <form id="checkoutForm">
            <div class="form-group">
                <label for="fullName">Full Name</label>
                <input type="text" id="fullName" name="fullName" required />
            </div>
            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" required />
            </div>
            <div class="form-group">
                <label for="address">Shipping Address</label>
                <input type="text" id="address" name="address" required />
            </div>

            <div class="form-group">
                <label>Payment Method</label>
                <div class="payment-options">
                    <label>
                        <input type="radio" name="paymentMethod" value="credit" required />
                        Credit
                    </label>
                    <label>
                        <input type="radio" name="paymentMethod" value="cash" />
                        Cash
                    </label>
                </div>
            </div>

            <div id="creditFields" class="hidden">
                <div class="form-group">
                    <label for="card">Credit Card Number</label>
                    <input type="text" id="card" name="card" />
                </div>
                <div class="form-group">
                    <label for="expiration">Expiration Date</label>
                    <input type="text" id="expiration" name="expiration" placeholder="MM/YY" />
                </div>
                <div class="form-group">
                    <label for="cvv">CVV</label>
                    <input type="text" id="cvv" name="cvv" />
                </div>
            </div>

            <button type="submit" class="submit-btn">Place Order</button>
        </form>
    </div>

    <div class="back-btn">
        <a href="/cart">← Back to Cart</a>
    </div>

    <script src="../JavaScript/cart.js"></script>
    <script>
        const creditFields = document.getElementById("creditFields");
        const paymentMethodRadios = document.getElementsByName("paymentMethod");
    
        paymentMethodRadios.forEach(radio => {
            radio.addEventListener("change", () => {
                if (radio.value === "credit") {
                    creditFields.classList.remove("hidden");
                } else {
                    creditFields.classList.add("hidden");
                }
            });
        });
    
        const expirationInput = document.getElementById("expiration");
        expirationInput.addEventListener("input", function () {
            let value = expirationInput.value.replace(/\D/g, "").slice(0, 4);
            if (value.length >= 3) {
                value = value.slice(0, 2) + "/" + value.slice(2);
            }
            expirationInput.value = value;
        });
    
        const cvvInput = document.getElementById("cvv");
        cvvInput.addEventListener("input", function () {
            cvvInput.value = cvvInput.value.replace(/\D/g, "").slice(0, 3);
        });
    
        const phoneInput = document.getElementById("phone");
        phoneInput.addEventListener("input", function () {
            phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 11);
        });
    
        const cardInput = document.getElementById("card");
        cardInput.addEventListener("input", function () {
            cardInput.value = cardInput.value.replace(/\D/g, "").slice(0, 16);
        });

        document.getElementById('checkoutForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const selectedPayment = document.querySelector('input[name="paymentMethod"]:checked').value;
            const phone = phoneInput.value.trim();
            const expiration = expirationInput.value.trim();
            const cvv = cvvInput.value.trim();
            const cardNumber = cardInput.value.trim();

            const phoneRegex = /^(010|011|012|015)\d{8}$/;
            if (!phoneRegex.test(phone)) {
                alert("Please enter a valid Egyptian phone number starting with 010, 011, 012, or 015.");
                return;
            }

            if (selectedPayment === "credit") {
                if (!/^\d{2}\/\d{2}$/.test(expiration)) {
                    alert("Expiration date must be in MM/YY format.");
                    return;
                }
                const [month, year] = expiration.split("/").map(Number);
                const currentDate = new Date();
                const currentYear = currentDate.getFullYear() % 100;
                const currentMonth = currentDate.getMonth() + 1;

                if (month < 1 || month > 12 || (year < currentYear || (year === currentYear && month < currentMonth))) {
                    alert("Expiration date is invalid or expired.");
                    return;
                }

                if (!/^\d{3}$/.test(cvv)) {
                    alert("CVV must be exactly 3 digits.");
                    return;
                }

                if (!/^\d{16}$/.test(cardNumber)) {
                    alert("Credit card number must be exactly 16 digits.");
                    return;
                }
            }

            alert('Order placed successfully!');
            localStorage.setItem('cart', '[]');
            window.location.href = '/home';
        });
    </script>
</body>
</html>"></html>