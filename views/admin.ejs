<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/admin.css">
    <script src="/JavaScript/admin.js" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Sidebar -->
    <aside id="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-crown"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin" class="active"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/admin/products"><i class="fas fa-box"></i> Products</a></li>
                <li><a href="/admin/add-product"><i class="fas fa-plus-circle"></i> Add Product</a></li>
                <li><a href="/admin/orders"><i class="fas fa-shopping-cart"></i> Orders</a></li>
                <li><a href="/admin/users"><i class="fas fa-users"></i> Users</a></li>
                <li><a href="/" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main id="main-content">
        <div class="dashboard-header fade-in">
            <h1><i class="fas fa-chart-line"></i> Dashboard Overview</h1>
            <div class="date">
                <i class="fas fa-calendar-alt"></i>
                <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid fade-in">
            <div class="stat-card">
                <h3><i class="fas fa-shopping-bag"></i> Today's Orders</h3>
                <p class="stat-number"><%= todaysOrders %></p>
            </div>
            <div class="stat-card">
                <h3><i class="fas fa-chart-bar"></i> Total Orders</h3>
                <p class="stat-number"><%= totalOrders %></p>
            </div>
            <div class="stat-card">
                <h3><i class="fas fa-clock"></i> Pending Orders</h3>
                <p class="stat-number"><%= pendingOrders %></p>
            </div>
            <div class="stat-card">
                <h3><i class="fas fa-times-circle"></i> Cancelled Orders</h3>
                <p class="stat-number"><%= cancelledOrders %></p>
            </div>
        </div>

        <!-- Recent Products -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-box-open"></i> Recent Products</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Date Added</th>
                            <th>Last Edited</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td><strong>#<%= product.id %></strong></td>
                                <td><%= product.name %></td>
                                <td><span class="badge badge-secondary"><%= product.category %></span></td>
                                <td><strong>EGP <%= product.price %></strong></td>
                                <td><%= product.dateAdded %></td>
                                <td><%= product.lastEdited %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recent Orders -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-shopping-cart"></i> Recent Orders</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Status</th>
                            <th>Date Placed</th>
                            <th>Last Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><strong>#<%= order.id %></strong></td>
                                <td><%= order.user %></td>
                                <td><%= order.product %></td>
                                <td>
                                    <% if (order.status === 'Pending') { %>
                                        <span class="badge badge-pending"><%= order.status %></span>
                                    <% } else if (order.status === 'Completed') { %>
                                        <span class="badge badge-completed"><%= order.status %></span>
                                    <% } else { %>
                                        <span class="badge badge-cancelled"><%= order.status %></span>
                                    <% } %>
                                </td>
                                <td><%= order.datePlaced %></td>
                                <td><%= order.lastEdited %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Hidden Logout Form -->
    <form id="logoutForm" action="/auth/logout" method="POST" style="display: none;"></form>

    <script>
        // Add smooth animations
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.stat-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
</body>
</html>