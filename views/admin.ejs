<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/admin.css">
    <script src="/JavaScript/admin.js" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Sidebar -->
    <aside id="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-crown"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin" class="active"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/admin/products"><i class="fas fa-box"></i> Products</a></li>
                <li><a href="/admin/add-product"><i class="fas fa-plus-circle"></i> Add Product</a></li>
                <li><a href="/admin/orders"><i class="fas fa-shopping-cart"></i> Orders</a></li>
                <li><a href="/admin/users"><i class="fas fa-users"></i> Users</a></li>
                <li><a href="/" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main id="main-content">
        <div class="dashboard-header fade-in">
            <h1><i class="fas fa-chart-line"></i> Dashboard Overview</h1>
            <div class="date">
                <i class="fas fa-calendar-alt"></i>
                <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid fade-in">
            <div class="stat-card">
                <h3><i class="fas fa-shopping-bag"></i> Total Products</h3>
                <p class="stat-number"><%= totalProducts %></p>
            </div>
            <div class="stat-card">
                <h3><i class="fas fa-users"></i> Total Users</h3>
                <p class="stat-number"><%= totalUsers %></p>
            </div>
            <div class="stat-card">
                <h3><i class="fas fa-user"></i> Regular Users</h3>
                <p class="stat-number"><%= regularUsers %></p>
            </div>
            <div class="stat-card">
                <h3><i class="fas fa-tags"></i> Categories</h3>
                <p class="stat-number"><%= categories.length %></p>
            </div>
        </div>

        <!-- Recent Products -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-box-open"></i> Recent Products</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Date Added</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td><strong>#<%= product._id %></strong></td>
                                <td><%= product.name %></td>
                                <td><span class="badge badge-secondary"><%= product.category %></span></td>
                                <td><strong>EGP <%= product.price %></strong></td>
                                <td><%= product.createdAt ? product.createdAt.toLocaleDateString() : '' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recent Orders -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-shopping-cart"></i> Recent Orders</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Products</th>
                            <th>Status</th>
                            <th>Date Placed</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><strong>#<%= order._id %></strong></td>
                                <td><%= order.user ? order.user.username : 'N/A' %></td>
                                <td>
                                    <% order.products.forEach(item => { %>
                                        <div><%= item.product ? item.product.name : 'N/A' %> (x<%= item.quantity %>)</div>
                                    <% }) %>
                                </td>
                                <td><%= order.status %></td>
                                <td><%= order.createdAt ? order.createdAt.toLocaleDateString() : '' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recent Users -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-users"></i> Recent Users</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Date Registered</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td><strong>#<%= user._id %></strong></td>
                                <td><%= user.username %></td>
                                <td><%= user.email %></td>
                                <td><%= user.role %></td>
                                <td><%= user.createdAt ? user.createdAt.toLocaleDateString() : '' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Hidden Logout Form -->
    <form id="logoutForm" action="/auth/logout" method="POST" style="display: none;"></form>

    <script>
        // Add smooth animations
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.stat-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
</body>
</html>