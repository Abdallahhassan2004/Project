<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/admin.css">
    <script src="/JavaScript/admin.js" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Sidebar -->
    <aside id="sidebar">
        <div class="sidebar-header">
            <h2>Admin Panel</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin">Dashboard</a></li>
                <li><a href="/admin/products">Products</a></li>
                <li><a href="/admin/orders">Orders</a></li>
                <li><a href="/admin/users">Users</a></li>
                <li><a href="/admin/settings">Settings</a></li>
                <li><a href="/" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">Logout</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main id="main-content">
        <div class="dashboard-header">
            <h1>Dashboard</h1>
            <div class="date">Today: <%= new Date().toLocaleDateString() %></div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Today's Orders</h3>
                <p class="stat-number"><%= todaysOrders %></p>
            </div>
            <div class="stat-card">
                <h3>Total Orders</h3>
                <p class="stat-number"><%= totalOrders %></p>
            </div>
            <div class="stat-card">
                <h3>Pending Orders</h3>
                <p class="stat-number"><%= pendingOrders %></p>
            </div>
            <div class="stat-card">
                <h3>Cancelled Orders</h3>
                <p class="stat-number"><%= cancelledOrders %></p>
            </div>
        </div>

        <!-- Recent Products -->
        <section class="recent-section">
            <h2>Recent Products</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Date Added</th>
                            <th>Last Edited</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td><%= product.id %></td>
                                <td><%= product.name %></td>
                                <td><%= product.category %></td>
                                <td><%= product.price %></td>
                                <td><%= product.dateAdded %></td>
                                <td><%= product.lastEdited %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recent Orders -->
        <section class="recent-section">
            <h2>Recent Orders</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Status</th>
                            <th>Date Placed</th>
                            <th>Last Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><%= order.id %></td>
                                <td><%= order.user %></td>
                                <td><%= order.product %></td>
                                <td><%= order.status %></td>
                                <td><%= order.datePlaced %></td>
                                <td><%= order.lastEdited %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Hidden Logout Form -->
    <form id="logoutForm" action="/auth/logout" method="POST" style="display: none;"></form>
</body>
</html>