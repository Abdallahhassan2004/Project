<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= '/CSS/users.css' %>">
    <script src="<%= '/JavaScript/admin.js' %>" defer></script>
    <script src="<%= '/JavaScript/users.js' %>" defer></script>
</head>
<body>
    <header>
        <h1>Admin Panel</h1>
        <nav>
            <ul>
                <li><a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
                <li><a href="/admin/users" class="<%= active === 'users' ? 'active' : '' %>">Users</a></li>
                <li><a href="/admin/orders" class="<%= active === 'orders' ? 'active' : '' %>">Orders</a></li>
                <li><a href="/admin/products" class="<%= active === 'products' ? 'active' : '' %>">Products</a></li>
                <li><a href="/admin/settings" class="<%= active === 'settings' ? 'active' : '' %>">Settings</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <h2>User Management</h2>
        <section id="users">
            <div class="actions">
                <button onclick="addNewUser()">Add New User</button>
                <input type="text" id="userSearch" placeholder="Search Users..." oninput="filterUsers()">
            </div>
            <table>
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.id %></td>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td><%= user.role %></td>
                            <td><%= user.status %></td>
                            <td><%= user.lastLogin %></td>
                            <td>
                                <button onclick="editUser('<%= user.id %>')">Edit</button>
                                <button onclick="deleteUser('<%= user.id %>')">Delete</button>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </section>
    </main>
    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Admin Panel</p>
    </footer>

    <script>
        function addNewUser() {
            // This should be replaced with actual add user functionality
            alert('Adding new user...');
        }

        function editUser(userId) {
            // This should be replaced with actual edit functionality
            alert(`Editing user ${userId}...`);
        }

        function deleteUser(userId) {
            // This should be replaced with actual delete functionality
            if (confirm(`Are you sure you want to delete user ${userId}?`)) {
                alert(`Deleting user ${userId}...`);
            }
        }

        function filterUsers() {
            const searchInput = document.getElementById('userSearch');
            const searchTerm = searchInput.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
