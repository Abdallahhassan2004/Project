<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/admin.css">
    <link rel="stylesheet" href="/CSS/orders.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="/JavaScript/admin.js" defer></script>
    <script src="/JavaScript/orders.js" defer></script>
  
</head>
<body>
    <!-- Sidebar -->
    <aside id="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-crown"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/admin/products"><i class="fas fa-box"></i> Products</a></li>
                <li><a href="/admin/add-product"><i class="fas fa-plus-circle"></i> Add Product</a></li>
                <li><a href="/admin/orders" class="active"><i class="fas fa-shopping-cart"></i> Orders</a></li>
                <li><a href="/admin/users"><i class="fas fa-users"></i> Users</a></li>
                <li><a href="/" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main id="main-content">
        <div class="dashboard-header fade-in">
            <h1><i class="fas fa-shopping-cart"></i> Order Management</h1>
            <div class="date">
                <i class="fas fa-calendar-alt"></i>
                <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>
        </div>

        <!-- Stats Summary -->
        <div class="stats-summary fade-in">
            <div class="stat-item">
                <h4><i class="fas fa-shopping-bag"></i> Total Orders</h4>
                <div class="number"><%= orders.length %></div>
            </div>
        </div>

        <!-- Actions Bar -->
        <div class="actions-bar fade-in">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" id="orderSearch" class="search-input" placeholder="Search orders by ID, user, or product..." oninput="filterOrders()">
            </div>
           
        </div>

        <!-- Orders Table -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-list"></i> All Orders</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>User</th>
                            <th>Product</th>
                            <th>Status</th>
                            <th>Date Placed</th>
                            <th>Last Edited</th>
                            <th>Total Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><strong>#<%= order._id %></strong></td>
                                <td><%= order.user ? order.user.username : 'N/A' %></td>
                                <td>
                                    <% order.products.forEach(item => { %>
                                        <div>
                                            <%= item.product ? item.product.name : 'N/A' %> (x<%= item.quantity %>)
                                            <br>
                                            <small class="text-muted">Price: <%= parseInt(item.price) %> EGP</small>
                                        </div>
                                    <% }) %>
                                </td>
                                <td>
                                    <div class="status-update-container">
                                        <select class="form-control status-select" 
                                                id="status-<%= order._id %>"
                                                data-order-id="<%= order._id %>">
                                            <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Processing</option>
                                            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                        <button class="btn btn-primary btn-sm save-status" 
                                                data-order-id="<%= order._id %>">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                    </div>
                                </td>
                                <td><%= order.createdAt ? order.createdAt.toLocaleDateString() : '' %></td>
                                <td><%= order.updatedAt ? order.updatedAt.toLocaleDateString() : '' %></td>
                                <td>
                                    <strong><%= parseInt(order.total) %> EGP</strong>
                                    <br>
                                    <small class="text-muted">
                                        <% order.products.forEach(item => { %>
                                            <%= item.product ? item.product.name : 'N/A' %>: <%= parseInt(item.price) * item.quantity %> EGP<br>
                                        <% }) %>
                                    </small>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Hidden Logout Form -->
    <form id="logoutForm" action="/auth/logout" method="POST" style="display: none;"></form>

    <script>
        // Save Order Status function
        function saveOrderStatus(orderId) {
            console.log('saveOrderStatus called with orderId:', orderId);
            
            const selectElement = document.getElementById(`status-${orderId}`);
            console.log('Select element:', selectElement);
            
            const saveButton = document.querySelector(`button[data-order-id="${orderId}"]`);
            console.log('Save button:', saveButton);
            
            const newStatus = selectElement.value;
            console.log('New status:', newStatus);
            
            const previousStatus = selectElement.dataset.previousStatus || selectElement.value;
            console.log('Previous status:', previousStatus);
            
            // Disable button and show loading
            saveButton.disabled = true;
            saveButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            
            console.log('Sending request to:', `/api/admin/orders/${orderId}/status`);
            
            // Send the request
            fetch(`/api/admin/orders/${orderId}/status`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ status: newStatus })
            })
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    return response.json().then(data => {
                        throw new Error(data.message || `HTTP error! status: ${response.status}`);
                    });
                }
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    showNotification('Status updated successfully!', 'success');
                    // Update the select element's previous status
                    selectElement.dataset.previousStatus = newStatus;
                    // Refresh the page after a short delay
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    throw new Error(data.message || 'Failed to update status');
                }
            })
            .catch(error => {
                console.error('Error updating status:', error);
                showNotification(error.message || 'Error updating status. Please try again.', 'error');
                // Revert to previous status
                selectElement.value = previousStatus;
            })
            .finally(() => {
                saveButton.disabled = false;
                saveButton.innerHTML = '<i class="fas fa-save"></i> Save';
            });
        }

        function exportOrders() {
            // This should be replaced with actual export functionality
            alert('Exporting orders...');
        }

        function filterOrders() {
            const searchInput = document.getElementById('orderSearch');
            const searchTerm = searchInput.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        }

        // Notification system
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Store previous status when select changes
        document.querySelectorAll('.status-select').forEach(select => {
            select.addEventListener('change', function() {
                console.log('Status changed to:', this.value);
                this.dataset.previousStatus = this.value;
            });
        });

        // Add event listeners when the page loads
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Page loaded, adding event listeners');
            
            // Add click event listeners to all save buttons
            document.querySelectorAll('.save-status').forEach(button => {
                button.addEventListener('click', function() {
                    const orderId = this.dataset.orderId;
                    console.log('Save button clicked for order:', orderId);
                    saveOrderStatus(orderId);
                });
            });

            // Add smooth animations
            const elements = document.querySelectorAll('.fade-in');
            elements.forEach((element, index) => {
                element.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
</body>
</html>