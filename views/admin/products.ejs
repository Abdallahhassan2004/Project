<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/admin.css">
    <link rel="stylesheet" href="/CSS/products.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
</head>
<body>
    <!-- Sidebar -->
    <aside id="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-crown"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/admin/products" class="active"><i class="fas fa-box"></i> Products</a></li>
                <li><a href="/admin/add-product"><i class="fas fa-plus-circle"></i> Add Product</a></li>
                <li><a href="/admin/orders"><i class="fas fa-shopping-cart"></i> Orders</a></li>
                <li><a href="/admin/users"><i class="fas fa-users"></i> Users</a></li>
                <li><a href="/" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main id="main-content">
        <!-- Notification Container -->
        <div id="notificationContainer" style="position: fixed; top: 20px; right: 20px; z-index: 1000;"></div>
        
        <div class="dashboard-header fade-in">
            <h1><i class="fas fa-box"></i> Product Management</h1>
            <div class="date">
                <i class="fas fa-calendar-alt"></i>
                <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>
        </div>

        <!-- Stats Summary -->
        <div class="stats-summary fade-in">
            <div class="stat-item">
                <h4><i class="fas fa-box"></i> Total Products</h4>
                <div class="number"><%= products.length %></div>
            </div>
            <div class="stat-item">
                <h4><i class="fas fa-tag"></i> Categories</h4>
                <div class="number"><%= [...new Set(products.map(p => p.category))].length %></div>
            </div>
            <div class="stat-item">
                <h4><i class="fas fa-star"></i> Featured</h4>
                <div class="number"><%= products.filter(p => p.featured).length || 0 %></div>
            </div>
        </div>

        <!-- Actions Bar -->
        <div class="actions-bar fade-in">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Search products by name or category..." oninput="filterProducts()">
            </div>
            <a href="/admin/add-product" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Product
            </a>
            <button class="btn btn-secondary" onclick="testRoutes()">
                <i class="fas fa-cog"></i> Test Routes
            </button>
            </div>

        <!-- Products Table -->
        <section class="recent-section fade-in">
            <h2><i class="fas fa-list"></i> All Products</h2>
            <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product => { %>
                        <tr>
                            <td>
                                <img src="/Images/<%= product.images.main %>" alt="<%= product.alt %>" class="product-image">
                            </td>
                            <td><%= product.name %></td>
                            <td><span class="badge badge-secondary"><%= product.category %></span></td>
                            <td><strong><%= product.price.replace('£', 'EGP ') %></strong></td>
                            <td>
                                <select class="form-control status-select" data-product-id="<%= product._id %>" onchange="updateStatus(this)">
                                    <option value="pending" <%= product.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="processing" <%= product.status === 'processing' ? 'selected' : '' %>>Processing</option>
                                    <option value="shipped" <%= product.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                    <option value="delivered" <%= product.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                    <option value="cancelled" <%= product.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        </section>
    </main>

    <!-- Hidden Logout Form -->
    <form id="logoutForm" action="/auth/logout" method="POST" style="display: none;"></form>

    <script>
        // Notification system
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Logout functionality
        function logout() {
            document.getElementById('logoutForm').submit();
        }

        // Update status function
        async function updateStatus(selectElement) {
            const productId = selectElement.dataset.productId;
            const newStatus = selectElement.value;
            
            try {
                const response = await fetch(`/api/admin/products/${productId}/status`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status: newStatus })
                });

                if (response.ok) {
                    showNotification(`Status updated to ${newStatus}`, 'success');
                    // Update the select element's class based on status
                    selectElement.className = `form-control status-select status-${newStatus}`;
                } else {
                    const error = await response.json();
                    showNotification(`Error: ${error.message}`, 'error');
                    // Revert the select to its previous value
                    selectElement.value = selectElement.dataset.previousValue;
                }
            } catch (error) {
                showNotification('Error updating status: ' + error.message, 'error');
                // Revert the select to its previous value
                selectElement.value = selectElement.dataset.previousValue;
            }
        }

        // Store previous value before change
        document.querySelectorAll('.status-select').forEach(select => {
            select.addEventListener('focus', function() {
                this.dataset.previousValue = this.value;
            });
        });

        function filterProducts() {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            const tbody = document.querySelector('tbody');
            const rows = tbody.getElementsByTagName('tr');

            for (let i = 0; i < rows.length; i++) {
                const name = rows[i].getElementsByTagName('td')[1].textContent.toLowerCase();
                const category = rows[i].getElementsByTagName('td')[2].textContent.toLowerCase();
                if (name.includes(filter) || category.includes(filter)) {
                    rows[i].style.display = '';
                } else {
                    rows[i].style.display = 'none';
                }
            }
        }

        // Test routes function
        function testRoutes() {
            const routes = [
                '/api/admin/products',
                '/api/admin/users',
                '/api/admin/orders'
            ];

            routes.forEach(route => {
                fetch(route)
                    .then(response => {
                        if (response.ok) {
                            showNotification(`Route ${route} is accessible`, 'success');
                        } else {
                            showNotification(`Route ${route} returned ${response.status}`, 'error');
                        }
                    })
                    .catch(error => {
                        showNotification(`Error testing ${route}: ${error.message}`, 'error');
                    });
            });
        }

        // Add smooth animations
        document.addEventListener('DOMContentLoaded', function() {
            const elements = document.querySelectorAll('.fade-in');
            elements.forEach((element, index) => {
                element.style.animationDelay = `${index * 0.1}s`;
            });
            
            // Add validation event listeners
            const editFields = ['editName', 'editCategory', 'editPrice', 'editDescription', 'editMainImage', 'editThumbnails', 'editAlt'];
            editFields.forEach(fieldName => {
                const element = document.getElementById(fieldName);
                if (element) {
                    element.addEventListener('input', function() {
                        validateField(fieldName, this.value);
                    });
                    
                    element.addEventListener('blur', function() {
                        validateField(fieldName, this.value);
                    });
                }
            });
            
            // Add image preview listeners
            document.getElementById('editMainImage').addEventListener('input', updateEditImagePreviews);
            document.getElementById('editThumbnails').addEventListener('input', updateEditImagePreviews);
            
            // Close modal when clicking outside
            document.getElementById('editProductModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closeEditModal();
                }
            });
        });
    </script>
</body>
</html>