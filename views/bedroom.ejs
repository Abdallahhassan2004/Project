<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="<%= '/CSS/category.css' %>">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&family=Ubuntu+Condensed&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        .product-details {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            overflow-y: auto;
        }

        .details-content {
            background: white;
            margin: 1rem auto;
            padding: 1.5rem;
            max-width: 1400px;
            width: 95%;
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            align-items: start;
        }

        .close-details {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            font-size: 1.5rem;
            cursor: pointer;
            color: #333;
            z-index: 1;
        }

        .image-gallery {
            display: grid;
            grid-template-columns: 80px 1fr;
            gap: 0.5rem;
        }

        .thumbnail-images {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            cursor: pointer;
            border-radius: 4px;
        }

        .main-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 8px;
        }

        .product-info {
            padding: 0.5rem;
        }

        .product-title {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            font-family: 'Bebas Neue', sans-serif;
        }

        .product-price {
            font-size: 1.25rem;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .product-description {
            color: #777;
            line-height: 1.4;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .add-to-cart-btn {
            background: #333;
            color: white;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.3s;
            width: 100%;
            max-width: 300px;
        }

        .add-to-cart-btn:hover {
            background: #444;
        }

        .related-products {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #eee;
            grid-column: 1 / -1;
        }

        .related-products h3 {
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
            font-family: 'Bebas Neue', sans-serif;
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.75rem;
        }

        .related-item {
            text-decoration: none;
            color: inherit;
            display: block;
            transition: transform 0.3s ease;
        }

        .related-item:hover {
            transform: translateY(-5px);
        }

        .related-item img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 0.25rem;
        }

        .related-item p {
            font-size: 0.9rem;
            color: #333;
        }

        .product {
            position: relative;
            overflow: hidden;
            border-radius: 8px;
            transition: transform 0.3s ease;
        }

        .product img {
            width: 100%;
            height: 320px;
            object-fit: cover;
            border-radius: 8px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .product:hover img {
            transform: scale(1.05);
        }

        .product:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .product .price {
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 0.5rem;
        }

        .product .product-title {
            display: block;
            margin-top: 10px;
            font-size: 1.1rem;
            color: #333;
        }

        @media (max-width: 768px) {
            .details-content {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .image-gallery {
                grid-template-columns: 60px 1fr;
            }

            .thumbnail {
                width: 60px;
                height: 60px;
            }

            .main-image {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header id="main-header">
        <div class="header-container">
            <%- include('partials/menu') %>
            <h1 class="logo"><a href="/">Sense</a></h1>
            <a href="/cart" class="cart">cart <span class="cart-count">0</span></a>
        </div>
    </header>

    <!-- Breadcrumb Section -->
    <section class="breadcrumb-section">
        <h1 class="h2style woocommerce-products-header__title uppercase heading-font">Bedroom Furniture</h1>
        <div class="content_section">
            <p class="p2 paragraph-font text-center">
                <span class="s1 span-font">
                    HOME / FURNITURE / BEDROOM
                </span>
            </p>
        </div>
    </section>

    <!-- Product List Section -->
    <div class="product-list">
        <% products.forEach(product => { %>
            <div class="product" data-product-id="<%= product._id %>" style="cursor: pointer;">
                <img src="/Images/<%= product.images.main %>" alt="<%= product.name %>">
                <p class="price"><%= product.price %></p>
                <p class="product-title"><%= product.name %></p>
            </div>
        <% }); %>
    </div>

    <!-- Product Details Modal -->
    <div id="productDetails" class="product-details">
        <div class="details-content">
            <span class="close-details" onclick="closeProductDetails()">&times;</span>
            <div class="image-gallery">
                <div class="thumbnail-images" id="thumbnailImages"></div>
                <img id="modalMainImage" src="" alt="Main product image" class="main-image">
            </div>
            <div class="product-info">
                <h2 id="modalProductTitle" class="product-title"></h2>
                <p id="modalProductPrice" class="product-price"></p>
                <p id="modalProductDescription" class="product-description"></p>
                <button class="add-to-cart-btn" onclick="addToCartLocal()">Add to Cart</button>
            </div>
            <!-- You May Also Like Section -->
            <div class="related-products">
                <h3>You May Also Like</h3>
                <div class="related-grid">
                    <a href="/livingrooms/livingroom2" class="related-item">
                        <img src="/Images/livingRooms/L2/L2.avif" alt="Contemporary Living Room">
                        <p>Contemporary Living Room</p>
                    </a>
                    <a href="/kitchens/kitchen1" class="related-item">
                        <img src="/Images/kitchen/kitchen 1/kit1 2.jpg" alt="Contemporary Kitchen">
                        <p>Contemporary Kitchen</p>
                    </a>
                    <a href="/dining/dining1" class="related-item">
                        <img src="/Images/dining/d1/1d.webp" alt="Contemporary Dining">
                        <p>Contemporary Dining</p>
                    </a>
                    <a href="/bedrooms/bedroom1" class="related-item">
                        <img src="/Images/bedrooms/b1/5.jpg" alt="Contemporary Bedroom">
                        <p>Contemporary Bedroom</p>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="footer-wrapper">
            <div class="footer-grid">
                <% const footerSections = [
                    { title: 'Store', links: ['Home', 'About', 'Journal', 'Contact'] },
                    { title: 'Shop', links: ['All', 'Lookbook', 'Collections', 'Featured'] },
                    { title: 'Collections', links: ['Decors', 'Furnitures', 'Ceramic', 'Lamps'] },
                    { title: 'Help', links: ['Contact', 'Login & Account', 'Privacy Policy', 'Refund policy'] }
                ]; %>
                
                <% footerSections.forEach(section => { %>
                    <div class="footer-box">
                        <h4><%= section.title %></h4>
                        <ul>
                            <% section.links.forEach(link => { %>
                                <li><a href="#"><%= link %></a></li>
                            <% }); %>
                        </ul>
                    </div>
                <% }); %>
            </div>
        </div>
        <div class="footer-brand">
            <h2>Sense</h2>
        </div>
    </footer>

    <script>
        const products = <%- JSON.stringify(products) %>;
        let currentProduct = null;

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.product').forEach(div => {
                div.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    showProductDetails(productId);
                });
            });
        });

        function showProductDetails(productId) {
            currentProduct = products.find(p => p._id === productId);
            if (!currentProduct) return;

            // Set main image
            document.getElementById('modalMainImage').src = '/Images/' + currentProduct.images.main;

            // Set thumbnails
            const thumbnailsDiv = document.getElementById('thumbnailImages');
            thumbnailsDiv.innerHTML = currentProduct.images.thumbnails.map(thumb =>
                <img src="/Images/${thumb}" class="thumbnail" onclick="updateMainImage('/Images/${thumb}')">
            ).join('');

            // Set other product info
            document.getElementById('modalProductTitle').textContent = currentProduct.name;
            document.getElementById('modalProductPrice').textContent = currentProduct.price;
            document.getElementById('modalProductDescription').textContent = currentProduct.description;

            // Show modal
            document.getElementById('productDetails').style.display = 'block';
        }

        function closeProductDetails() {
            document.getElementById('productDetails').style.display = 'none';
            currentProduct = null;
        }

        function updateMainImage(src) {
            document.getElementById('modalMainImage').src = src;
        }

        function addToCartLocal() {
            if (!currentProduct) return;
            // Call the global addToCart function directly
            window.addToCart(currentProduct._id);
        }

        function updateCartCount(count) {
            const cartCountElement = document.querySelector('.cart-count');
            if (cartCountElement) {
                cartCountElement.textContent = count;
            }
        }

        // Update cart count on page load
        fetch('/cart/count')
            .then(response => response.json())
            .then(data => {
                updateCartCount(data.count);
            })
            .catch(error => {
                console.error('Error fetching cart count:', error);
            });

        function handleSearchClick() {
            const query = document.getElementById('search-input').value.trim().toLowerCase();
            const roomPages = {
                "living": "/living",
                "living room": "/living",
                "bed": "/bedroom",
                "bedroom": "/bedroom",
                "kitchen": "/kitchen",
                "dining": "/dining",
                "dining room": "/dining"
            };

            const matchedKey = Object.keys(roomPages).find(key => query.includes(key));

            if (matchedKey) {
                window.location.href = roomPages[matchedKey];
            } else {
                alert("No matching room found. Try: living, bed, kitchen, dining.");
            }
        }

        function toggleMenu() {
            const menu = document.getElementById("fullMenu");
            const toggleBtn = document.querySelector(".menu-toggle");
            menu.classList.toggle("active");
            toggleBtn.textContent = menu.classList.contains("active") ? "✕" : "☰";
        }
    </script>
</body>
</html>