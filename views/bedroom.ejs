<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../CSS/category.css">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&family=Ubuntu+Condensed&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poiret+One&family=Share+Tech&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Header -->
<header id="main-header">
    <div class="header-container">
        <div class="menu-toggle animate-icon" onclick="toggleMenu()">☰</div>
        <h1 class="logo"><a href="Home.html">Sense</a></h1>

        <a href="cart.html" class="cart">bag <span></span>
            <span class="cart-count">0</span>
        </a>
    </div>

    <div class="full-menu" id="fullMenu">
        <div class="menu-left">
            <!-- 🔍 Search Bar -->
            <div class="menu-search">
                <input type="text" id="search-input" placeholder="Search for products..." />
                <button onclick="handleSearchClick()">Search</button>
            </div>

            <!-- Menu Columns -->
            <div class="menu-columns">
                <div class="column">
                    <h2>Sense</h2>
                    <ul>
                        <li><a href="Home.html#about-section">About</a></li>
                        <li><a href="Home.html#contact-section">Contact</a></li>
                        <li><a href="login.html">Log In</a></li>
                        <li><a href="signup.html">Sign Up</a></li>
                    </ul>
                </div>
                <div class="column">
                    <h2>SHOP</h2>
                    <ul>
                        <li><a href="Home.html">Home</a></li>
                        <li><a href="living.html">Living Room</a></li>
                        <li><a href="bedroom.html">Bedroom</a></li>
                        <li><a href="kitchen.html">Kitchen</a></li>
                        <li><a href="dining.html">Dining Room</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Image Section -->
        <div class="menu-right">
            <img src="../Images/Home/intro5.jpg" alt="Hm1" />
        </div>
    </div>
</header>

<!-- Breadcrumb Section -->
<section class="breadcrumb-section">
    <h1 class="h2style woocommerce-products-header__title uppercase heading-font">BedRoom Furniture</h1>
    <div class="content_section">
        <p class="p2 paragraph-font text-center">
            <span class="s1 span-font">
                HOME / FURNITURE / BEDROOM
            </span>
        </p>
    </div>
</section>

<!-- Product List Section -->
<div class="product-list">
    <% const products = [
        { href: "bedrooms/bedroom1.html", imgSrc: "../Images/bedroom/bedroom1.jpg", alt: "Luxury Bed", price: "£1,499", title: "Mediterranean Bedroom" },
        { href: "bedrooms/bedroom2.html", imgSrc: "../Images/bedroom/bedroom2.jpg", alt: "Bedside Table", price: "£1,599", title: "Bohemian Bedroom" },
        { href: "bedrooms/bedroom3.html", imgSrc: "../Images/bedroom/bedroom3.jpg", alt: "Memory Foam Mattress", price: "£1,800", title: "Vintage Bedroom" },
        { href: "bedrooms/bedroom4.html", imgSrc: "../Images/bedroom/bedroom4.jpg", alt: "Wooden Drawer", price: "£165", title: "Japandi Bedroom" },
        { href: "bedrooms/bedroom5.html", imgSrc: "../Images/bedroom/bedroom5.jpg", alt: "Modern Wardrobe", price: "£450", title: "Charcoal Sophistication Bedroom" },
        { href: "bedrooms/bedroom6.html", imgSrc: "../Images/bedroom/Bedroom6.jpg", alt: "Elegant Dresser", price: "£550", title: "Grey Modernity Bedroom" }
    ]; %>
    <% products.forEach(product => { %>
        <div class="product">
            <a href="<%= product.href %>">
                <img src="<%= product.imgSrc %>" alt="<%= product.alt %>">
            </a>
            <div class="price"><%= product.price %></div>
            <a href="<%= product.href %>" class="product-title"><%= product.title %></a>
        </div>
    <% }); %>
</div>

<footer>
    <div class="footer-wrapper">
        <!-- Grid Columns with Bordered Boxes -->
        <div class="footer-grid">
            <div class="footer-box">
                <h4>Store</h4>
                <ul>
                    <li><a href="#">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Journal</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </div>

            <div class="footer-box">
                <h4>Shop</h4>
                <ul>
                    <li><a href="#">All</a></li>
                    <li><a href="#">Lookbook</a></li>
                    <li><a href="#">Collections</a></li>
                    <li><a href="#">Featured</a></li>
                </ul>
            </div>

            <div class="footer-box">
                <h4>Collections</h4>
                <ul>
                    <li><a href="#">Decors</a></li>
                    <li><a href="#">Furnitures</a></li>
                    <li><a href="#">Ceramic</a></li>
                    <li><a href="#">Lamps</a></li>
                </ul>
            </div>

            <div class="footer-box">
                <h4>Help</h4>
                <ul>
                    <li><a href="#">Contact</a></li>
                    <li><a href="#">Login & Account</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Refund policy</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Store name in its own full-width block at the bottom -->
    <div class="footer-brand">
        <h2>Sense</h2>
    </div>
</footer>

<script>
    function searchProducts() {
        var input = document.getElementById('search-input').value.toLowerCase();
    }

    document.getElementById('search-input').addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            searchProducts();

            const query = event.target.value.trim().toLowerCase();
            const roomPages = {
                "living room": "living.html",
                "bedroom": "bedroom.html",
                "kitchen": "kitchen.html",
                "dining": "dining.html"
            };

            const matchedPage = Object.keys(roomPages).find(room =>
                room.toLowerCase().includes(query)
            );

            if (matchedPage) {
                window.location.href = roomPages[matchedPage];
            } else {
                alert("No matching room found. Try typing part of the room name (e.g., 'living', 'bed', 'kitchen').");
            }
        }
    });

    function handleSearchClick() {
        searchProducts();

        const query = document.getElementById('search-input').value.trim().toLowerCase();
        const roomPages = {
            "living room": "living.html",
            "bedroom": "bedroom.html",
            "kitchen": "kitchen.html",
            "dining": "dining.html"
        };

        const matchedPage = Object.keys(roomPages).find(room =>
            room.toLowerCase().includes(query)
        );

        if (matchedPage) {
            window.location.href = roomPages[matchedPage];
        } else {
            alert("No matching room found. Try typing part of the room name (e.g., 'living', 'bed', 'kitchen').");
        }
    }

    function toggleMenu() {
        const menu = document.getElementById("fullMenu");
        menu.classList.toggle("active");
    }
</script>
</body>
</html>